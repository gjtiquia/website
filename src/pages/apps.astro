---
import Layout from "../layouts/Layout.astro";
import HeaderSection from "../components/HeaderSection.astro";
import FooterSection from "../components/FooterSection.astro";
import AppCard from "../components/apps/AppCard.astro";
---

<Layout title="apps🚀 - GJ Tiquia" description="a list of cool apps🚀">
    <main class="px-4 min-h-dvh flex flex-col items-center">
        <HeaderSection />
        <section class="w-full max-w-2xl pt-4">
            <h1 class="text-text font-mono font-bold text-center text-2xl">
                apps🚀
            </h1>
        </section>

        <section class="w-full pt-6 max-w-2xl">
            <ul class="flex flex-col gap-4">
                <AppCard
                    href="https://cp.gjt.io/"
                    title="IJUSTWANNACOPYPASTE"
                    description="I JUST WANNA COPY PASTE SOME TEXT FROM ONE COMPUTER TO ANOTHER"
                />

                <AppCard
                    href="https://cURLy.gjt.io/"
                    title="cURLy"
                    description="snake game with cURL"
                />

                <AppCard
                    href="https://minitextarea.gjt.io/"
                    title="mini-textarea"
                    description="a fast, simple <textarea/> that just works"
                />
            </ul>
        </section>

        <div class="flex-grow"></div>
        <FooterSection />
    </main>
</Layout>
