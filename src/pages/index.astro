---
import Layout from "../layouts/Layout.astro";
import HeaderSection from "../components/HeaderSection.astro";
import FooterSection from "../components/FooterSection.astro";
import GitHubLogo from "../components/Logos/GitHubLogo.astro";
import LinkedInLogo from "../components/Logos/LinkedInLogo.astro";
import TwitterLogo from "../components/Logos/TwitterLogo.astro";
import HomeCard from "../components/home/HomeCard.astro";

// TODO : portfolio (can do much much later)
/* portfolio
- (add a part to resume)
- filipino, born and raised in hong kong, now living in canada
- short bio: im an artist, code is my canvas
- (want to know more about me? -> principles/working with doc)
- professional work experience: 9cat, various projects
- educational background (hku, mech, cs, drone, ai)
- volunteer (game dev happy hour, hkugmg, worship team) 
- hobbies (music, gaming, basketball)
*/

/*
maybe add a sitemap...?
and probably better descriptions so it'll turn up nicer in Google Search results
*/
---

<Layout title="GJ Tiquia👋" description="home page">
    <main class="px-4 min-h-dvh flex flex-col items-center">
        <HeaderSection />

        <div class="sm:flex-1"></div>

        <section
            class="max-w-2xl mx-auto py-4 sm:py-12 flex flex-col items-center gap-4"
        >
            <div>
                <p class="text-iris font-mono pb-2">hey there! im</p>
                <h1
                    class="text-text text-center text-4xl sm:text-5xl font-bold pb-4"
                >
                    GJ Tiquia<span class="inline-block animate-wave">👋</span>
                </h1>
                <div class="">
                    <p class="text-subtle text-sm sm:text-base font-mono">
                        just a regular guy doing things for fun :)
                    </p>
                </div>
            </div>

            <ul class="flex gap-6 sm:pt-6">
                <li><TwitterLogo /></li>
                <li><GitHubLogo /></li>
                <li><LinkedInLogo /></li>
            </ul>
        </section>

        <section
            class="border border-surface bg-surface/50 backdrop-blur-md w-full sm:w-full max-w-5xl flex flex-col items-center gap-4 sm:gap-6 px-8 pt-4 pb-6 sm:pt-6 sm:pb-10 rounded-lg"
        >
            <p class="text-subtle font-mono">why are you here?</p>
            <ul
                class="w-full max-w-xs sm:max-w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"
            >
                <HomeCard
                    href="/portfolio"
                    title="portfolio💼"
                    description="professional stuff"
                />

                <HomeCard
                    href="/garden"
                    title="garden🌷"
                    description="creative stuff"
                />

                <HomeCard
                    href="/games"
                    title="games🎮"
                    description="fun stuff"
                />

                <HomeCard
                    href="/apps"
                    title="apps🚀"
                    description="cool stuff"
                />
            </ul>
        </section>

        <div class="flex-1 sm:flex-[2_1_0%]"></div>
        <FooterSection />
    </main>
</Layout>

<style>
    .animate-wave {
        animation: wave 2.5s infinite;
        transform-origin: 70% 70%;
        display: inline-block;
    }

    @keyframes wave {
        0% {
            transform: rotate(0deg);
        }
        10% {
            transform: rotate(14deg);
        }
        20% {
            transform: rotate(-8deg);
        }
        30% {
            transform: rotate(14deg);
        }
        40% {
            transform: rotate(-4deg);
        }
        50% {
            transform: rotate(10deg);
        }
        60% {
            transform: rotate(0deg);
        }
        100% {
            transform: rotate(0deg);
        }
    }
</style>
